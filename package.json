{
  "name": "mineru-layout-viewer",
  "version": "0.1.1",
  "description": "Visualize MinerU layout.json output — side-by-side PDF + Markdown with bidirectional navigation",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "plugins",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/mineru-layout-viewer.iife.js"
    },
    "./web-component": {
      "types": "./dist/mineru-viewer.d.ts",
      "import": "./dist/mineru-viewer.mjs",
      "default": "./dist/mineru-layout-viewer.iife.js"
    }
  },
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "dev": "node build.mjs --watch",
    "test": "npm run build && node --test tests",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mineru",
    "pdf",
    "markdown",
    "layout",
    "viewer",
    "web-component",
    "document-parsing"
  ],
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": ""
  },
  "peerDependencies": {
    "jszip": "^3.10.1",
    "pdfjs-dist": "^3.11.174"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "esbuild": "^0.24.0",
    "pdfjs-dist": "^3.11.174",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.1",
    "@replit/codemirror-vim": "^6.4.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.14",
    "katex": "^0.18.4",
    "markdown-it": "^15.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-texmath": "^1.0.0"
  }
}
